{
  "name": "sshr-database-suite",
  "version": "1.0.2",
  "description": "Electron suite for SSHR database migrate, backup, and restore",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/linphonesmilax/sshr-database-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/linphonesmilax/sshr-database-suite.git"
  },
  "author": {
    "name": "smilax",
    "email": "dev@sshr.local"
  },
  "desktopName": "sshr-database-suite",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview -- --no-sandbox",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release:linux": "electron-vite build && electron-builder --linux --publish always"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.37.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.smilax.sshr-database-suite",
    "productName": "SSHR Database Suite",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "linphonesmilax",
        "repo": "sshr-database-suite",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Utility",
      "synopsis": "Backup, restore, and migrate SSHR databases",
      "description": "Desktop app for SSHR PostgreSQL backup, restore, and Prisma migrations.",
      "executableName": "sshr-database-suite",
      "maintainer": "smilax <dev@sshr.local>",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "sshr-database-suite_${version}_${arch}.deb",
      "depends": [
        "postgresql-client",
        "ca-certificates"
      ],
      "recommends": [
        "nodejs (>= 20)",
        "npm"
      ]
    },
    "appImage": {
      "artifactName": "SSHR-Database-Suite-${version}-${arch}.AppImage"
    }
  }
}
